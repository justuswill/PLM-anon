#!/bin/bash
# Pretrained models: plm-1.3B-beta0.5, ar-topk decoding, the 200 FineWeb-Edu prompts of the Figure 1 judge (judge player vllm_plm_1.3b_beta0.5_pre_ar_topk).
# Warm-up pass, then seeds 0 1 2; seed 0 becomes the judge's samples file. Generated by scripts/make_runs.py; submit from the repository root.
#SBATCH --job-name=plm-pre-plm-1.3B-beta0.5-ar-topk
#SBATCH --time=02:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --output=results/logs/%x-%j.log
#SBATCH --error=results/logs/%x-%j.log

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$PWD}"
CHECKPOINTS=${CHECKPOINTS:-checkpoints}

mkdir -p results/pretrain/plm-1.3B-beta0.5-ar-topk results/pretrain/samples
uv run --no-sync python -m plm.generate --model "$CHECKPOINTS/pretrain/plm-1.3B-beta0.5" --ar --ar-sampler topk --dataset data/fineweb-edu/prompts.json --tokens 128     --max-model-len 4096 --seeds 0 1 2 --out results/pretrain/plm-1.3B-beta0.5-ar-topk/fineweb-edu.json
uv run --no-sync python -m plm.eval.judge_samples --results results/pretrain/plm-1.3B-beta0.5-ar-topk/fineweb-edu.json --prompts data/fineweb-edu/prompts.jsonl --seed 0     --model vllm_plm_1.3b_beta0.5_pre_ar_topk --out results/pretrain/samples/vllm_plm_1.3b_beta0.5_pre_ar_topk.jsonl
