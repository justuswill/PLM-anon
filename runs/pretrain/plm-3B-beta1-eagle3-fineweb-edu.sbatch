#!/bin/bash
# Pretrained models: plm-3B-beta1, eagle3 decoding, the 200 FineWeb-Edu prompts of the Figure 1 judge (judge player vllm_plm_3b_beta1_pre_eagle3).
# Warm-up pass, then seeds 0 1 2; seed 0 becomes the judge's samples file. Generated by scripts/make_runs.py; submit from the repository root.
#SBATCH --job-name=plm-pre-plm-3B-beta1-eagle3
#SBATCH --time=02:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --output=results/logs/%x-%j.log
#SBATCH --error=results/logs/%x-%j.log

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$PWD}"
CHECKPOINTS=${CHECKPOINTS:-checkpoints}

mkdir -p results/pretrain/plm-3B-beta1-eagle3 results/pretrain/samples
uv run --no-sync python -m plm.generate --model "$CHECKPOINTS/pretrain/plm-3B-beta1" --ar --ar-sampler topk --eagle3 "$CHECKPOINTS/pretrain/eagle3-plm-3B-beta1" --dataset data/fineweb-edu/prompts.json --tokens 128     --max-model-len 4096 --seeds 0 1 2 --out results/pretrain/plm-3B-beta1-eagle3/fineweb-edu.json
uv run --no-sync python -m plm.eval.judge_samples --results results/pretrain/plm-3B-beta1-eagle3/fineweb-edu.json --prompts data/fineweb-edu/prompts.jsonl --seed 0     --model vllm_plm_3b_beta1_pre_eagle3 --out results/pretrain/samples/vllm_plm_3b_beta1_pre_eagle3.jsonl
