#!/bin/bash
# Table 11: plm-3B-beta1, ar-topk decoding, ifeval. Warm-up pass, then seeds 0 1 2; graded at the end.
# Generated by scripts/make_runs.py; submit from the repository root.
#SBATCH --job-name=plm-plm-3B-beta1-ar-topk-ifeval
#SBATCH --time=06:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --output=results/logs/%x-%j.log
#SBATCH --error=results/logs/%x-%j.log

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$PWD}"
CHECKPOINTS=${CHECKPOINTS:-checkpoints}
export PYTHONPATH=third_party NLTK_DATA=third_party/nltk_data

[ -f prompts/ifeval/tasks.json ] || uv run --no-sync python -m bench.eval.build_prompts --benchmark ifeval --tokenizer "$CHECKPOINTS/posttrain/plm-1.3B-beta1" --out-dir prompts/ifeval
mkdir -p results/posttrain/plm-3B-beta1-ar-topk
uv run --no-sync python -m bench.generate --model "$CHECKPOINTS/posttrain/plm-3B-beta1" --ar --ar-sampler topk --dataset prompts/ifeval/prompts.json --tokens 1280 \
    --max-model-len 4096 --stop-at-eos --seeds 0 1 2 --out results/posttrain/plm-3B-beta1-ar-topk/ifeval.json
uv run --no-sync python -m bench.eval.score --benchmark ifeval --results results/posttrain/plm-3B-beta1-ar-topk/ifeval.json --tasks prompts/ifeval/tasks.json
